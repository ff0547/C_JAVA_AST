  620                  | DimsNoAnnotations LBRACK ']'

  621 ClassInstanceCreationExpression: UnqualifiedClassInstanceCreationExpression
  622                                | CommonName '.' UnqualifiedClassInstanceCreationExpression
  623                                | Primary '.' UnqualifiedClassInstanceCreationExpression

