  730                    | VAR

  731 LambdaBody: Expression
  732           | Block

  733 AssignmentExpression: ConditionalExpression
  734                     | Assignment

  735 Assignment: LeftHandSide AssignmentOperator Expression

  736 LeftHandSide: CommonName
  737             | FieldAccess
  738             | ArrayAccess

  739 AssignmentOperator: '='
  740                   | MUL_ASSIGN
  741                   | DIV_ASSIGN
  742                   | MOD_ASSIGN
  743                   | ADD_ASSIGN
  744                   | SUB_ASSIGN
  745                   | SHL_ASSIGN
  746                   | SHR_ASSIGN
  747                   | USHR_ASSIGN
  748                   | AND_ASSIGN
  749                   | XOR_ASSIGN
  750                   | OR_ASSIGN

  751 ConditionalExpression: ConditionalOrExpression
  752                      | ConditionalOrExpression '?' Expression ':' ConditionalExpression
  753                      | ConditionalOrExpression '?' Expression ':' LambdaExpression

  754 ConditionalOrExpression: ConditionalAndExpression
  755                        | ConditionalOrExpression OR ConditionalAndExpression

  756 ConditionalAndExpression: InclusiveOrExpression
  757                         | ConditionalAndExpression AND InclusiveOrExpression

  758 InclusiveOrExpression: ExclusiveOrExpression
  759                      | InclusiveOrExpression '|' ExclusiveOrExpression

  760 ExclusiveOrExpression: AndExpression
  761                      | ExclusiveOrExpression '^' AndExpression

  762 AndExpression: EqualityExpression
  763              | AndExpression '&' EqualityExpression

  764 EqualityExpression: RelationalExpression
  765                   | EqualityExpression EQ RelationalExpression
  766                   | EqualityExpression NE RelationalExpression

  767 SimpleRelationalExpression: ShiftExpression

  768 RelationalExpression: SimpleRelationalExpression
  769                     | SimpleRelationalExpression INSTANCEOF ReferenceType
  770                     | SimpleRelationalExpression INSTANCEOF Pattern
  771                     | SimpleRelationalExpression '<' ShiftExpression
  772                     | SimpleRelationalExpression '>' ShiftExpression
  773                     | SimpleRelationalExpression LE ShiftExpression
  774                     | SimpleRelationalExpression GE ShiftExpression

  775 ShiftExpression: AdditiveExpression
