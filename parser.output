  646            | NEW UnannPrimitiveType Dims ArrayInitializer LBRACK_ArrayAccess Expression ']'
  647            | NEW ClassOrInterfaceType Dims ArrayInitializer LBRACK_ArrayAccess Expression ']'

  648 MethodInvocation: IDENTIFIER_MethodDeclarator '(' ArgumentList ')'
  649                 | IDENTIFIER_MethodDeclarator '(' ')'
  650                 | CommonName '.' TypeArguments IDENTIFIER_MethodDeclarator '(' ArgumentList ')'
  651                 | CommonName '.' TypeArguments IDENTIFIER_MethodDeclarator '(' ')'
  652                 | CommonName '.' IDENTIFIER_MethodDeclarator '(' ArgumentList ')'
  653                 | CommonName '.' IDENTIFIER_MethodDeclarator '(' ')'
  654                 | Primary '.' TypeArguments IDENTIFIER_MethodDeclarator '(' ArgumentList ')'
  655                 | Primary '.' TypeArguments IDENTIFIER_MethodDeclarator '(' ')'
  656                 | Primary '.' IDENTIFIER_MethodDeclarator '(' ArgumentList ')'
  657                 | Primary '.' IDENTIFIER_MethodDeclarator '(' ')'
  658                 | SUPER '.' TypeArguments IDENTIFIER_MethodDeclarator '(' ArgumentList ')'
  659                 | SUPER '.' TypeArguments IDENTIFIER_MethodDeclarator '(' ')'
  660                 | SUPER '.' IDENTIFIER_MethodDeclarator '(' ArgumentList ')'
  661                 | SUPER '.' IDENTIFIER_MethodDeclarator '(' ')'
  662                 | CommonName '.' SUPER '.' TypeArguments IDENTIFIER_MethodDeclarator '(' ArgumentList ')'
  663                 | CommonName '.' SUPER '.' TypeArguments IDENTIFIER_MethodDeclarator '(' ')'
  664                 | CommonName '.' SUPER '.' IDENTIFIER_MethodDeclarator '(' ArgumentList ')'
  665                 | CommonName '.' SUPER '.' IDENTIFIER_MethodDeclarator '(' ')'

  666 ArgumentList: Expression
  667             | ArgumentList ',' Expression

  668 MethodReference: Primary DOUBLE_COLON TypeArguments TYPE_IDENTIFIER
  669                | Primary DOUBLE_COLON TYPE_IDENTIFIER
