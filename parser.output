  781                   | AdditiveExpression '-' MultiplicativeExpression

  782 MultiplicativeExpression: UnaryExpression
  783                         | MultiplicativeExpression '*' UnaryExpression
  784                         | MultiplicativeExpression '/' UnaryExpression
  785                         | MultiplicativeExpression '%' UnaryExpression

  786 UnaryExpression: PreIncrementExpression
  787                | PreDecrementExpression
  788                | '+' UnaryExpression
  789                | '-' UnaryExpression
  790                | UnaryExpressionNotPlusMinus

  791 PreIncrementExpression: PREFIX_INC UnaryExpression

  792 PreDecrementExpression: PREFIX_DEC UnaryExpression

  793 UnaryExpressionNotPlusMinus: PostfixExpression
  794                            | '~' UnaryExpression
  795                            | '!' UnaryExpression
  796                            | CastExpression
  797                            | SwitchExpression

  798 PostfixExpression: Primary
