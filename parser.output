  626                                           | NEW TypeArguments ClassOrInterfaceTypeToInstantiate '(' ')' ClassBody
  627                                           | NEW TypeArguments ClassOrInterfaceTypeToInstantiate '(' ')'
  628                                           | NEW ClassOrInterfaceTypeToInstantiate '(' ArgumentList ')' ClassBody
  629                                           | NEW ClassOrInterfaceTypeToInstantiate '(' ArgumentList ')'
