  800                  | PostIncrementExpression
  801                  | PostDecrementExpression

  802 PostIncrementExpression: PostfixExpression INC_OP

  803 PostDecrementExpression: PostfixExpression DEC_OP

  804 CastExpression: '(' PrimitiveType ')' UnaryExpression
  805               | '(' UnannPrimitiveType ')' UnaryExpression
  806               | '(' ReferenceType AdditionalBounds RPAREN_CastExpression UnaryExpressionNotPlusMinus
  807               | '(' ReferenceType AdditionalBounds RPAREN_CastExpression LambdaExpression

  808 SwitchExpression: SWITCH '(' Expression ')' SwitchBlock


