  537                              | FOR '(' VariableModifiers LocalVariableType IdentifierComplement Dims ':' Expression ')' StatementNoShortIf
  538                              | FOR '(' Annotations LocalVariableType IdentifierComplement Dims ':' Expression ')' StatementNoShortIf
  539                              | FOR '(' LocalVariableType IdentifierComplement Dims ':' Expression ')' StatementNoShortIf
  540                              | FOR '(' VariableModifiers LocalVariableType IdentifierComplement ':' Expression ')' StatementNoShortIf
  541                              | FOR '(' Annotations LocalVariableType IdentifierComplement ':' Expression ')' StatementNoShortIf
  542                              | FOR '(' LocalVariableType IdentifierComplement ':' Expression ')' StatementNoShortIf

  543 BreakStatement: BREAK TYPE_IDENTIFIER ';'
  544               | BREAK IdentifierComplement ';'
  545               | BREAK ';'

  546 YieldStatement: YIELD Expression ';'

  547 ContinueStatement: CONTINUE ';'
  548                  | CONTINUE TYPE_IDENTIFIER ';'
  549                  | CONTINUE IdentifierComplement ';'

  550 ReturnStatement: RETURN Expression ';'
  551                | RETURN ';'

  552 ThrowStatement: THROW Expression ';'

  553 SynchronizedStatement: SYNCHRONIZED '(' Expression ')' Block

  554 TryStatement: TRY Block Catches
  555             | TRY Block Catches Finally
  556             | TRY Block Finally
  557             | TryWithResourcesStatement

  558 Catches: CatchClause
  559        | Catches CatchClause

  560 CatchClause: CATCH '(' CatchFormalParameter ')' Block

  561 CatchFormalParameter: VariableModifiers CatchType TYPE_IDENTIFIER Dims
  562                     | Annotations CatchType TYPE_IDENTIFIER Dims
  563                     | CatchType TYPE_IDENTIFIER Dims
  564                     | VariableModifiers CatchType TYPE_IDENTIFIER
  565                     | Annotations CatchType TYPE_IDENTIFIER
  566                     | CatchType TYPE_IDENTIFIER
  567                     | VariableModifiers CatchType IdentifierComplement Dims
  568                     | Annotations CatchType IdentifierComplement Dims
  569                     | CatchType IdentifierComplement Dims
  570                     | VariableModifiers CatchType IdentifierComplement
  571                     | Annotations CatchType IdentifierComplement
  572                     | CatchType IdentifierComplement

  573 CatchType: UnannClassOrInterfaceType
  574          | CatchType '|' ClassOrInterfaceType

  575 Finally: FINALLY Block

  576 TryWithResourcesStatement: TRY ResourceSpecification Block Catches Finally
  577                          | TRY ResourceSpecification Block Catches
  578                          | TRY ResourceSpecification Block Finally
  579                          | TRY ResourceSpecification Block

  580 ResourceSpecification: '(' ResourceList ')'
  581                      | '(' ResourceList ';' ')'

  582 ResourceList: Resource
  583             | ResourceList ';' Resource

  584 Resource: VariableModifiers LocalVariableType TYPE_IDENTIFIER '=' Expression
  585         | Annotations LocalVariableType TYPE_IDENTIFIER '=' Expression
  586         | LocalVariableType TYPE_IDENTIFIER '=' Expression
  587         | VariableModifiers LocalVariableType IdentifierComplement '=' Expression
  588         | Annotations LocalVariableType IdentifierComplement '=' Expression
  589         | LocalVariableType IdentifierComplement '=' Expression
  590         | VariableAccess

  591 VariableAccess: CommonName
  592               | FieldAccess

  593 Pattern: TypePattern

  594 TypePattern: LocalVariableDeclaration_TypePattern

  595 LocalVariableDeclaration_TypePattern: VariableModifiers LocalVariableType VariableDeclarator
  596                                     | Annotations LocalVariableType VariableDeclarator
  597                                     | LocalVariableType VariableDeclarator

  598 Primary: PrimaryNoNewArray
  599        | ArrayCreationExpression

  600 PrimaryNoNewArray: Literal
  601                  | ClassLiteral
  602                  | THIS
  603                  | CommonName '.' THIS
  604                  | '(' Expression ')'
  605                  | ClassInstanceCreationExpression
  606                  | FieldAccess
  607                  | ArrayAccess
  608                  | MethodInvocation
  609                  | MethodReference

  610 ClassLiteral: CommonName DimsNoAnnotations '.' CLASS
  611             | NumericType DimsNoAnnotations '.' CLASS
  612             | BOOLEAN DimsNoAnnotations '.' CLASS
  613             | CommonName '.' CLASS
  614             | NumericType '.' CLASS
  615             | BOOLEAN '.' CLASS
  616             | VOID '.' CLASS

  617 DimsNoAnnotations: LBRACK ']'
  618                  | DimsNoAnnotations LBRACK ']'

  619 ClassInstanceCreationExpression: UnqualifiedClassInstanceCreationExpression
  620                                | CommonName '.' UnqualifiedClassInstanceCreationExpression
  621                                | Primary '.' UnqualifiedClassInstanceCreationExpression

  622 UnqualifiedClassInstanceCreationExpression: NEW TypeArguments ClassOrInterfaceTypeToInstantiate '(' ArgumentList ')' ClassBody
  623                                           | NEW TypeArguments ClassOrInterfaceTypeToInstantiate '(' ArgumentList ')'
  624                                           | NEW TypeArguments ClassOrInterfaceTypeToInstantiate '(' ')' ClassBody
  625                                           | NEW TypeArguments ClassOrInterfaceTypeToInstantiate '(' ')'
  626                                           | NEW ClassOrInterfaceTypeToInstantiate '(' ArgumentList ')' ClassBody
  627                                           | NEW ClassOrInterfaceTypeToInstantiate '(' ArgumentList ')'
  628                                           | NEW ClassOrInterfaceTypeToInstantiate '(' ')' ClassBody
  629                                           | NEW ClassOrInterfaceTypeToInstantiate '(' ')'

  630 ClassOrInterfaceTypeToInstantiate: AnnotationIdentifiers TypeArgumentsOrDiamond
  631                                  | AnnotationIdentifiers

  632 AnnotationIdentifiers: Annotations IDENTIFIER_AnnotationIdentifiers
  633                      | IDENTIFIER_AnnotationIdentifiers
  634                      | AnnotationIdentifiers '.' Annotations IDENTIFIER_AnnotationIdentifiers
  635                      | AnnotationIdentifiers '.' IDENTIFIER_AnnotationIdentifiers

  636 TypeArgumentsOrDiamond: TypeArguments
  637                       | DIAMOND

  638 FieldAccess: Primary '.' TYPE_IDENTIFIER
  639            | SUPER '.' TYPE_IDENTIFIER
  640            | CommonName '.' SUPER '.' TYPE_IDENTIFIER
  641            | Primary '.' IdentifierComplement
  642            | SUPER '.' IdentifierComplement
  643            | CommonName '.' SUPER '.' IdentifierComplement

  644 ArrayAccess: CommonName LBRACK_ArrayAccess Expression ']'
  645            | PrimaryNoNewArray LBRACK_ArrayAccess Expression ']'
  646            | NEW PrimitiveType Dims ArrayInitializer LBRACK_ArrayAccess Expression ']'
  647            | NEW UnannPrimitiveType Dims ArrayInitializer LBRACK_ArrayAccess Expression ']'
  648            | NEW ClassOrInterfaceType Dims ArrayInitializer LBRACK_ArrayAccess Expression ']'

  649 MethodInvocation: IDENTIFIER_MethodDeclarator '(' ArgumentList ')'
  650                 | IDENTIFIER_MethodDeclarator '(' ')'
  651                 | CommonName '.' TypeArguments IDENTIFIER_MethodDeclarator '(' ArgumentList ')'
  652                 | CommonName '.' TypeArguments IDENTIFIER_MethodDeclarator '(' ')'
  653                 | CommonName '.' IDENTIFIER_MethodDeclarator '(' ArgumentList ')'
  654                 | CommonName '.' IDENTIFIER_MethodDeclarator '(' ')'
  655                 | Primary '.' TypeArguments IDENTIFIER_MethodDeclarator '(' ArgumentList ')'
  656                 | Primary '.' TypeArguments IDENTIFIER_MethodDeclarator '(' ')'
  657                 | Primary '.' IDENTIFIER_MethodDeclarator '(' ArgumentList ')'
  658                 | Primary '.' IDENTIFIER_MethodDeclarator '(' ')'
  659                 | SUPER '.' TypeArguments IDENTIFIER_MethodDeclarator '(' ArgumentList ')'
  660                 | SUPER '.' TypeArguments IDENTIFIER_MethodDeclarator '(' ')'
  661                 | SUPER '.' IDENTIFIER_MethodDeclarator '(' ArgumentList ')'
  662                 | SUPER '.' IDENTIFIER_MethodDeclarator '(' ')'
  663                 | CommonName '.' SUPER '.' TypeArguments IDENTIFIER_MethodDeclarator '(' ArgumentList ')'
  664                 | CommonName '.' SUPER '.' TypeArguments IDENTIFIER_MethodDeclarator '(' ')'
  665                 | CommonName '.' SUPER '.' IDENTIFIER_MethodDeclarator '(' ArgumentList ')'
  666                 | CommonName '.' SUPER '.' IDENTIFIER_MethodDeclarator '(' ')'

  667 ArgumentList: Expression
  668             | ArgumentList ',' Expression

  669 MethodReference: Primary DOUBLE_COLON TypeArguments TYPE_IDENTIFIER
  670                | Primary DOUBLE_COLON TYPE_IDENTIFIER
  671                | ReferenceType DOUBLE_COLON TypeArguments TYPE_IDENTIFIER
  672                | ReferenceType DOUBLE_COLON TYPE_IDENTIFIER
  673                | SUPER DOUBLE_COLON TypeArguments TYPE_IDENTIFIER
  674                | SUPER DOUBLE_COLON TYPE_IDENTIFIER
  675                | CommonName '.' SUPER DOUBLE_COLON TypeArguments TYPE_IDENTIFIER
  676                | CommonName '.' SUPER DOUBLE_COLON TYPE_IDENTIFIER
  677                | Primary DOUBLE_COLON TypeArguments IdentifierComplement
  678                | Primary DOUBLE_COLON IdentifierComplement
  679                | ReferenceType DOUBLE_COLON TypeArguments IdentifierComplement
  680                | ReferenceType DOUBLE_COLON IdentifierComplement
  681                | SUPER DOUBLE_COLON TypeArguments IdentifierComplement
  682                | SUPER DOUBLE_COLON IdentifierComplement
  683                | CommonName '.' SUPER DOUBLE_COLON TypeArguments IdentifierComplement
  684                | CommonName '.' SUPER DOUBLE_COLON IdentifierComplement
  685                | ReferenceType DOUBLE_COLON TypeArguments NEW
  686                | ReferenceType DOUBLE_COLON NEW

  687 ArrayCreationExpression: NEW PrimitiveType DimExprs Dims
  688                        | NEW PrimitiveType DimExprs
  689                        | NEW UnannPrimitiveType DimExprs Dims
  690                        | NEW UnannPrimitiveType DimExprs
  691                        | NEW ClassOrInterfaceType DimExprs Dims
  692                        | NEW ClassOrInterfaceType DimExprs
  693                        | NEW PrimitiveType Dims ArrayInitializer
  694                        | NEW UnannPrimitiveType Dims ArrayInitializer
  695                        | NEW ClassOrInterfaceType Dims ArrayInitializer

  696 DimExprs: DimExpr
  697         | DimExprs DimExpr

  698 DimExpr: Annotations_Dims LBRACK_ArrayAccess Expression ']'
  699        | LBRACK_ArrayAccess Expression ']'

  700 Expression: LambdaExpression
  701           | AssignmentExpression

  702 LambdaExpression: LambdaParameters ARROW LambdaBody

  703 LambdaParameters: '(' LambdaParameterList ')'
  704                 | '(' ')'
  705                 | TYPE_IDENTIFIER_IdentifierforLambdaParameterList
  706                 | IdentifierComplement_IdentifierforLambdaParameterList

  707 LambdaParameterList: LambdaParameterforLambdaParameterList
  708                    | IdentifierforLambdaParameterList

  709 IdentifierforLambdaParameterList: TYPE_IDENTIFIER_IdentifierforLambdaParameterList
  710                                 | IdentifierComplement_IdentifierforLambdaParameterList
  711                                 | IdentifierforLambdaParameterList ',' TYPE_IDENTIFIER_IdentifierforLambdaParameterList
  712                                 | IdentifierforLambdaParameterList ',' IdentifierComplement_IdentifierforLambdaParameterList

  713 IdentifierComplement_IdentifierforLambdaParameterList: VAR_IdentifierComplement_IdentifierforLambdaParameterList
  714                                                      | YIELD_IdentifierComplement_IdentifierforLambdaParameterList

  715 LambdaParameterforLambdaParameterList: LambdaParameter
  716                                      | LambdaParameterforLambdaParameterList ',' LambdaParameter

  717 LambdaParameter: VariableModifiers LambdaParameterType TYPE_IDENTIFIER Dims
  718                | Annotations LambdaParameterType TYPE_IDENTIFIER Dims
  719                | LambdaParameterType TYPE_IDENTIFIER Dims
  720                | VariableModifiers LambdaParameterType TYPE_IDENTIFIER
  721                | Annotations LambdaParameterType TYPE_IDENTIFIER
  722                | LambdaParameterType TYPE_IDENTIFIER
  723                | VariableModifiers LambdaParameterType IdentifierComplement Dims
  724                | Annotations LambdaParameterType IdentifierComplement Dims
  725                | LambdaParameterType IdentifierComplement Dims
  726                | VariableModifiers LambdaParameterType IdentifierComplement
  727                | Annotations LambdaParameterType IdentifierComplement
  728                | LambdaParameterType IdentifierComplement
  729                | VariableArityParameter

  730 LambdaParameterType: UnannType
  731                    | VAR

  732 LambdaBody: Expression
  733           | Block

  734 AssignmentExpression: ConditionalExpression
  735                     | Assignment

  736 Assignment: LeftHandSide AssignmentOperator Expression

  737 LeftHandSide: CommonName
  738             | FieldAccess
  739             | ArrayAccess

  740 AssignmentOperator: '='
  741                   | MUL_ASSIGN
  742                   | DIV_ASSIGN
  743                   | MOD_ASSIGN
  744                   | ADD_ASSIGN
  745                   | SUB_ASSIGN
  746                   | SHL_ASSIGN
  747                   | SHR_ASSIGN
  748                   | USHR_ASSIGN
  749                   | AND_ASSIGN
  750                   | XOR_ASSIGN
  751                   | OR_ASSIGN

  752 ConditionalExpression: ConditionalOrExpression
  753                      | ConditionalOrExpression '?' Expression ':' ConditionalExpression
  754                      | ConditionalOrExpression '?' Expression ':' LambdaExpression

  755 ConditionalOrExpression: ConditionalAndExpression
  756                        | ConditionalOrExpression OR ConditionalAndExpression

  757 ConditionalAndExpression: InclusiveOrExpression
  758                         | ConditionalAndExpression AND InclusiveOrExpression

  759 InclusiveOrExpression: ExclusiveOrExpression
  760                      | InclusiveOrExpression '|' ExclusiveOrExpression

  761 ExclusiveOrExpression: AndExpression
  762                      | ExclusiveOrExpression '^' AndExpression

  763 AndExpression: EqualityExpression
  764              | AndExpression '&' EqualityExpression

  765 EqualityExpression: RelationalExpression
  766                   | EqualityExpression EQ RelationalExpression
  767                   | EqualityExpression NE RelationalExpression

  768 SimpleRelationalExpression: ShiftExpression

  769 RelationalExpression: SimpleRelationalExpression
  770                     | SimpleRelationalExpression INSTANCEOF ReferenceType
  771                     | SimpleRelationalExpression INSTANCEOF Pattern
  772                     | SimpleRelationalExpression '<' ShiftExpression
  773                     | SimpleRelationalExpression '>' ShiftExpression
  774                     | SimpleRelationalExpression LE ShiftExpression
  775                     | SimpleRelationalExpression GE ShiftExpression

  776 ShiftExpression: AdditiveExpression
  777                | ShiftExpression SHL_OP AdditiveExpression
  778                | ShiftExpression SHR_OP AdditiveExpression
  779                | ShiftExpression USHR_OP AdditiveExpression

  780 AdditiveExpression: MultiplicativeExpression
  781                   | AdditiveExpression '+' MultiplicativeExpression
  782                   | AdditiveExpression '-' MultiplicativeExpression

  783 MultiplicativeExpression: UnaryExpression
  784                         | MultiplicativeExpression '*' UnaryExpression
  785                         | MultiplicativeExpression '/' UnaryExpression
  786                         | MultiplicativeExpression '%' UnaryExpression

  787 UnaryExpression: PreIncrementExpression
  788                | PreDecrementExpression
  789                | '+' UnaryExpression
  790                | '-' UnaryExpression
  791                | UnaryExpressionNotPlusMinus

  792 PreIncrementExpression: PREFIX_INC UnaryExpression

  793 PreDecrementExpression: PREFIX_DEC UnaryExpression

  794 UnaryExpressionNotPlusMinus: PostfixExpression
  795                            | '~' UnaryExpression
  796                            | '!' UnaryExpression
  797                            | CastExpression
  798                            | SwitchExpression

  799 PostfixExpression: Primary
  800                  | CommonName
  801                  | PostIncrementExpression
  802                  | PostDecrementExpression

  803 PostIncrementExpression: PostfixExpression INC_OP

  804 PostDecrementExpression: PostfixExpression DEC_OP

  805 CastExpression: '(' PrimitiveType ')' UnaryExpression
  806               | '(' UnannPrimitiveType ')' UnaryExpression
  807               | '(' ReferenceType AdditionalBounds RPAREN_CastExpression UnaryExpressionNotPlusMinus
  808               | '(' ReferenceType AdditionalBounds RPAREN_CastExpression LambdaExpression

  809 SwitchExpression: SWITCH '(' Expression ')' SwitchBlock


