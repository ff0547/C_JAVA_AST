  534                              | FOR '(' LocalVariableType IdentifierComplement Dims ':' Expression ')' StatementNoShortIf
  535                              | FOR '(' VariableModifiers LocalVariableType IdentifierComplement ':' Expression ')' StatementNoShortIf
  536                              | FOR '(' Annotations LocalVariableType IdentifierComplement ':' Expression ')' StatementNoShortIf
  537                              | FOR '(' LocalVariableType IdentifierComplement ':' Expression ')' StatementNoShortIf

  538 BreakStatement: BREAK TYPE_IDENTIFIER ';'
  539               | BREAK IdentifierComplement ';'
  540               | BREAK ';'

  541 YieldStatement: YIELD Expression ';'

  542 ContinueStatement: CONTINUE ';'
  543                  | CONTINUE TYPE_IDENTIFIER ';'
  544                  | CONTINUE IdentifierComplement ';'

  545 ReturnStatement: RETURN Expression ';'
  546                | RETURN ';'

  547 ThrowStatement: THROW Expression ';'

  548 SynchronizedStatement: SYNCHRONIZED '(' Expression ')' Block

  549 TryStatement: TRY Block Catches
  550             | TRY Block Catches Finally
  551             | TRY Block Finally
  552             | TryWithResourcesStatement

  553 Catches: CatchClause
  554        | Catches CatchClause

  555 CatchClause: CATCH '(' CatchFormalParameter ')' Block

  556 CatchFormalParameter: VariableModifiers CatchType TYPE_IDENTIFIER Dims
  557                     | Annotations CatchType TYPE_IDENTIFIER Dims
  558                     | CatchType TYPE_IDENTIFIER Dims
  559                     | VariableModifiers CatchType TYPE_IDENTIFIER
  560                     | Annotations CatchType TYPE_IDENTIFIER
  561                     | CatchType TYPE_IDENTIFIER
  562                     | VariableModifiers CatchType IdentifierComplement Dims
  563                     | Annotations CatchType IdentifierComplement Dims
  564                     | CatchType IdentifierComplement Dims
  565                     | VariableModifiers CatchType IdentifierComplement
  566                     | Annotations CatchType IdentifierComplement
  567                     | CatchType IdentifierComplement

  568 CatchType: UnannClassOrInterfaceType
  569          | CatchType '|' ClassOrInterfaceType

  570 Finally: FINALLY Block

  571 TryWithResourcesStatement: TRY ResourceSpecification Block Catches Finally
  572                          | TRY ResourceSpecification Block Catches
  573                          | TRY ResourceSpecification Block Finally
  574                          | TRY ResourceSpecification Block

  575 ResourceSpecification: '(' ResourceList ')'
  576                      | '(' ResourceList ';' ')'

  577 ResourceList: Resource
  578             | ResourceList ';' Resource

  579 Resource: VariableModifiers LocalVariableType TYPE_IDENTIFIER '=' Expression
  580         | Annotations LocalVariableType TYPE_IDENTIFIER '=' Expression
  581         | LocalVariableType TYPE_IDENTIFIER '=' Expression
  582         | VariableModifiers LocalVariableType IdentifierComplement '=' Expression
  583         | Annotations LocalVariableType IdentifierComplement '=' Expression
  584         | LocalVariableType IdentifierComplement '=' Expression
  585         | VariableAccess

  586 VariableAccess: CommonName
  587               | FieldAccess

  588 Pattern: TypePattern

  589 TypePattern: LocalVariableDeclaration_TypePattern

  590 LocalVariableDeclaration_TypePattern: VariableModifiers LocalVariableType VariableDeclarator
  591                                     | Annotations LocalVariableType VariableDeclarator
  592                                     | LocalVariableType VariableDeclarator

  593 Primary: PrimaryNoNewArray
  594        | ArrayCreationExpression

  595 PrimaryNoNewArray: Literal
  596                  | ClassLiteral
  597                  | THIS
  598                  | CommonName '.' THIS
  599                  | '(' Expression ')'
  600                  | ClassInstanceCreationExpression
  601                  | FieldAccess
  602                  | ArrayAccess
  603                  | MethodInvocation
  604                  | MethodReference

  605 ClassLiteral: CommonName DimsNoAnnotations '.' CLASS
  606             | NumericType DimsNoAnnotations '.' CLASS
  607             | BOOLEAN DimsNoAnnotations '.' CLASS
  608             | CommonName '.' CLASS
  609             | NumericType '.' CLASS
  610             | BOOLEAN '.' CLASS
  611             | VOID '.' CLASS

  612 DimsNoAnnotations: LBRACK ']'
  613                  | DimsNoAnnotations LBRACK ']'

  614 ClassInstanceCreationExpression: UnqualifiedClassInstanceCreationExpression
  615                                | CommonName '.' UnqualifiedClassInstanceCreationExpression
  616                                | Primary '.' UnqualifiedClassInstanceCreationExpression

  617 UnqualifiedClassInstanceCreationExpression: NEW TypeArguments ClassOrInterfaceTypeToInstantiate '(' ArgumentList ')' ClassBody
  618                                           | NEW TypeArguments ClassOrInterfaceTypeToInstantiate '(' ArgumentList ')'
  619                                           | NEW TypeArguments ClassOrInterfaceTypeToInstantiate '(' ')' ClassBody
  620                                           | NEW TypeArguments ClassOrInterfaceTypeToInstantiate '(' ')'
  621                                           | NEW ClassOrInterfaceTypeToInstantiate '(' ArgumentList ')' ClassBody
  622                                           | NEW ClassOrInterfaceTypeToInstantiate '(' ArgumentList ')'
  623                                           | NEW ClassOrInterfaceTypeToInstantiate '(' ')' ClassBody
  624                                           | NEW ClassOrInterfaceTypeToInstantiate '(' ')'

  625 ClassOrInterfaceTypeToInstantiate: AnnotationIdentifiers TypeArgumentsOrDiamond
  626                                  | AnnotationIdentifiers

  627 AnnotationIdentifiers: Annotations IDENTIFIER_AnnotationIdentifiers
  628                      | IDENTIFIER_AnnotationIdentifiers
  629                      | AnnotationIdentifiers '.' Annotations IDENTIFIER_AnnotationIdentifiers
  630                      | AnnotationIdentifiers '.' IDENTIFIER_AnnotationIdentifiers

  631 TypeArgumentsOrDiamond: TypeArguments
  632                       | DIAMOND

  633 FieldAccess: Primary '.' TYPE_IDENTIFIER
  634            | SUPER '.' TYPE_IDENTIFIER
  635            | CommonName '.' SUPER '.' TYPE_IDENTIFIER
  636            | Primary '.' IdentifierComplement
  637            | SUPER '.' IdentifierComplement
  638            | CommonName '.' SUPER '.' IdentifierComplement

  639 ArrayAccess: CommonName LBRACK_ArrayAccess Expression ']'
  640            | PrimaryNoNewArray LBRACK_ArrayAccess Expression ']'
  641            | NEW PrimitiveType Dims ArrayInitializer LBRACK_ArrayAccess Expression ']'
  642            | NEW UnannPrimitiveType Dims ArrayInitializer LBRACK_ArrayAccess Expression ']'
  643            | NEW ClassOrInterfaceType Dims ArrayInitializer LBRACK_ArrayAccess Expression ']'

  644 MethodInvocation: IDENTIFIER_MethodDeclarator '(' ArgumentList ')'
  645                 | IDENTIFIER_MethodDeclarator '(' ')'
  646                 | CommonName '.' TypeArguments IDENTIFIER_MethodDeclarator '(' ArgumentList ')'
  647                 | CommonName '.' TypeArguments IDENTIFIER_MethodDeclarator '(' ')'
  648                 | CommonName '.' IDENTIFIER_MethodDeclarator '(' ArgumentList ')'
  649                 | CommonName '.' IDENTIFIER_MethodDeclarator '(' ')'
  650                 | Primary '.' TypeArguments IDENTIFIER_MethodDeclarator '(' ArgumentList ')'
  651                 | Primary '.' TypeArguments IDENTIFIER_MethodDeclarator '(' ')'
  652                 | Primary '.' IDENTIFIER_MethodDeclarator '(' ArgumentList ')'
  653                 | Primary '.' IDENTIFIER_MethodDeclarator '(' ')'
  654                 | SUPER '.' TypeArguments IDENTIFIER_MethodDeclarator '(' ArgumentList ')'
  655                 | SUPER '.' TypeArguments IDENTIFIER_MethodDeclarator '(' ')'
  656                 | SUPER '.' IDENTIFIER_MethodDeclarator '(' ArgumentList ')'
  657                 | SUPER '.' IDENTIFIER_MethodDeclarator '(' ')'
  658                 | CommonName '.' SUPER '.' TypeArguments IDENTIFIER_MethodDeclarator '(' ArgumentList ')'
  659                 | CommonName '.' SUPER '.' TypeArguments IDENTIFIER_MethodDeclarator '(' ')'
  660                 | CommonName '.' SUPER '.' IDENTIFIER_MethodDeclarator '(' ArgumentList ')'
  661                 | CommonName '.' SUPER '.' IDENTIFIER_MethodDeclarator '(' ')'

  662 ArgumentList: Expression
  663             | ArgumentList ',' Expression

  664 MethodReference: Primary DOUBLE_COLON TypeArguments TYPE_IDENTIFIER
  665                | Primary DOUBLE_COLON TYPE_IDENTIFIER
  666                | ReferenceType DOUBLE_COLON TypeArguments TYPE_IDENTIFIER
  667                | ReferenceType DOUBLE_COLON TYPE_IDENTIFIER
  668                | SUPER DOUBLE_COLON TypeArguments TYPE_IDENTIFIER
  669                | SUPER DOUBLE_COLON TYPE_IDENTIFIER
  670                | CommonName '.' SUPER DOUBLE_COLON TypeArguments TYPE_IDENTIFIER
  671                | CommonName '.' SUPER DOUBLE_COLON TYPE_IDENTIFIER
  672                | Primary DOUBLE_COLON TypeArguments IdentifierComplement
  673                | Primary DOUBLE_COLON IdentifierComplement
  674                | ReferenceType DOUBLE_COLON TypeArguments IdentifierComplement
  675                | ReferenceType DOUBLE_COLON IdentifierComplement
  676                | SUPER DOUBLE_COLON TypeArguments IdentifierComplement
  677                | SUPER DOUBLE_COLON IdentifierComplement
  678                | CommonName '.' SUPER DOUBLE_COLON TypeArguments IdentifierComplement
  679                | CommonName '.' SUPER DOUBLE_COLON IdentifierComplement
  680                | ReferenceType DOUBLE_COLON TypeArguments NEW
  681                | ReferenceType DOUBLE_COLON NEW

  682 ArrayCreationExpression: NEW PrimitiveType DimExprs Dims
  683                        | NEW PrimitiveType DimExprs
  684                        | NEW UnannPrimitiveType DimExprs Dims
  685                        | NEW UnannPrimitiveType DimExprs
  686                        | NEW ClassOrInterfaceType DimExprs Dims
  687                        | NEW ClassOrInterfaceType DimExprs
  688                        | NEW PrimitiveType Dims ArrayInitializer
  689                        | NEW UnannPrimitiveType Dims ArrayInitializer
  690                        | NEW ClassOrInterfaceType Dims ArrayInitializer

  691 DimExprs: DimExpr
  692         | DimExprs DimExpr

  693 DimExpr: Annotations_Dims LBRACK_ArrayAccess Expression ']'
  694        | LBRACK_ArrayAccess Expression ']'

  695 Expression: LambdaExpression
  696           | AssignmentExpression

  697 LambdaExpression: LambdaParameters ARROW LambdaBody

  698 LambdaParameters: '(' LambdaParameterList ')'
  699                 | '(' ')'
  700                 | TYPE_IDENTIFIER_IdentifierforLambdaParameterList
  701                 | IdentifierComplement_IdentifierforLambdaParameterList

  702 LambdaParameterList: LambdaParameterforLambdaParameterList
  703                    | IdentifierforLambdaParameterList

  704 IdentifierforLambdaParameterList: TYPE_IDENTIFIER_IdentifierforLambdaParameterList
  705                                 | IdentifierComplement_IdentifierforLambdaParameterList
  706                                 | IdentifierforLambdaParameterList ',' TYPE_IDENTIFIER_IdentifierforLambdaParameterList
  707                                 | IdentifierforLambdaParameterList ',' IdentifierComplement_IdentifierforLambdaParameterList

  708 IdentifierComplement_IdentifierforLambdaParameterList: VAR_IdentifierComplement_IdentifierforLambdaParameterList
  709                                                      | YIELD_IdentifierComplement_IdentifierforLambdaParameterList

  710 LambdaParameterforLambdaParameterList: LambdaParameter
  711                                      | LambdaParameterforLambdaParameterList ',' LambdaParameter

  712 LambdaParameter: VariableModifiers LambdaParameterType TYPE_IDENTIFIER Dims
  713                | Annotations LambdaParameterType TYPE_IDENTIFIER Dims
  714                | LambdaParameterType TYPE_IDENTIFIER Dims
  715                | VariableModifiers LambdaParameterType TYPE_IDENTIFIER
  716                | Annotations LambdaParameterType TYPE_IDENTIFIER
  717                | LambdaParameterType TYPE_IDENTIFIER
  718                | VariableModifiers LambdaParameterType IdentifierComplement Dims
  719                | Annotations LambdaParameterType IdentifierComplement Dims
  720                | LambdaParameterType IdentifierComplement Dims
  721                | VariableModifiers LambdaParameterType IdentifierComplement
  722                | Annotations LambdaParameterType IdentifierComplement
  723                | LambdaParameterType IdentifierComplement
  724                | VariableArityParameter

  725 LambdaParameterType: UnannType
  726                    | VAR

  727 LambdaBody: Expression
  728           | Block

  729 AssignmentExpression: ConditionalExpression
  730                     | Assignment

  731 Assignment: LeftHandSide AssignmentOperator Expression

  732 LeftHandSide: CommonName
  733             | FieldAccess
  734             | ArrayAccess

  735 AssignmentOperator: '='
  736                   | MUL_ASSIGN
  737                   | DIV_ASSIGN
  738                   | MOD_ASSIGN
  739                   | ADD_ASSIGN
  740                   | SUB_ASSIGN
  741                   | SHL_ASSIGN
  742                   | SHR_ASSIGN
  743                   | USHR_ASSIGN
  744                   | AND_ASSIGN
  745                   | XOR_ASSIGN
  746                   | OR_ASSIGN

  747 ConditionalExpression: ConditionalOrExpression
  748                      | ConditionalOrExpression '?' Expression ':' ConditionalExpression
  749                      | ConditionalOrExpression '?' Expression ':' LambdaExpression

  750 ConditionalOrExpression: ConditionalAndExpression
  751                        | ConditionalOrExpression OR ConditionalAndExpression

  752 ConditionalAndExpression: InclusiveOrExpression
  753                         | ConditionalAndExpression AND InclusiveOrExpression

  754 InclusiveOrExpression: ExclusiveOrExpression
  755                      | InclusiveOrExpression '|' ExclusiveOrExpression

  756 ExclusiveOrExpression: AndExpression
  757                      | ExclusiveOrExpression '^' AndExpression

  758 AndExpression: EqualityExpression
  759              | AndExpression '&' EqualityExpression

  760 EqualityExpression: RelationalExpression
  761                   | EqualityExpression EQ RelationalExpression
  762                   | EqualityExpression NE RelationalExpression

  763 SimpleRelationalExpression: ShiftExpression

  764 RelationalExpression: SimpleRelationalExpression
  765                     | SimpleRelationalExpression INSTANCEOF ReferenceType
  766                     | SimpleRelationalExpression INSTANCEOF Pattern
  767                     | SimpleRelationalExpression '<' ShiftExpression
  768                     | SimpleRelationalExpression '>' ShiftExpression
  769                     | SimpleRelationalExpression LE ShiftExpression
  770                     | SimpleRelationalExpression GE ShiftExpression

  771 ShiftExpression: AdditiveExpression
  772                | ShiftExpression SHL_OP AdditiveExpression
  773                | ShiftExpression SHR_OP AdditiveExpression
  774                | ShiftExpression USHR_OP AdditiveExpression

  775 AdditiveExpression: MultiplicativeExpression
  776                   | AdditiveExpression '+' MultiplicativeExpression
  777                   | AdditiveExpression '-' MultiplicativeExpression

  778 MultiplicativeExpression: UnaryExpression
  779                         | MultiplicativeExpression '*' UnaryExpression
  780                         | MultiplicativeExpression '/' UnaryExpression
  781                         | MultiplicativeExpression '%' UnaryExpression

  782 UnaryExpression: PreIncrementExpression
  783                | PreDecrementExpression
  784                | '+' UnaryExpression
  785                | '-' UnaryExpression
  786                | UnaryExpressionNotPlusMinus

  787 PreIncrementExpression: PREFIX_INC UnaryExpression

  788 PreDecrementExpression: PREFIX_DEC UnaryExpression

  789 UnaryExpressionNotPlusMinus: PostfixExpression
  790                            | '~' UnaryExpression
  791                            | '!' UnaryExpression
  792                            | CastExpression
  793                            | SwitchExpression

  794 PostfixExpression: Primary
  795                  | CommonName
  796                  | PostIncrementExpression
  797                  | PostDecrementExpression

  798 PostIncrementExpression: PostfixExpression INC_OP

  799 PostDecrementExpression: PostfixExpression DEC_OP

  800 CastExpression: '(' PrimitiveType ')' UnaryExpression
  801               | '(' UnannPrimitiveType ')' UnaryExpression
  802               | '(' ReferenceType AdditionalBounds RPAREN_CastExpression UnaryExpressionNotPlusMinus
  803               | '(' ReferenceType AdditionalBounds RPAREN_CastExpression LambdaExpression

  804 SwitchExpression: SWITCH '(' Expression ')' SwitchBlock


